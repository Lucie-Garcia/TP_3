---
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
import PlotFigure from "./PlotFigure.astro";

interface Props {
	species: string;
}

const { species } = Astro.props;
const penguinsOfSpecies = penguins.filter(
	(penguin) => penguin.species === species,
);
---

<div class="flex flex-col items-center justify-center">
	<h2 class="text-xl">Graphique pour l'espèce : {species}</h2>
	<p class="text-sm text-accent-content">
		Nombre d'individus : {penguinsOfSpecies.length}
	</p>
	<PlotFigure
		options={{
			marks: [
				Plot.dot(penguinsOfSpecies, {
					x: "culmen_length_mm",
					y: "culmen_depth_mm",
					stroke: "species",
				}),
			],
		}}
	/>
</div>
