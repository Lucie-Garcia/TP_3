---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" data-theme="cupcake">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <nav class="flex flex-row gap-5 p-5 bg-base-200 justify-center">
      <a href="/" class="menu-item btn btn-primary w-1/5">Accueil</a>
      <a href="/species/Adelie" class="menu-item btn btn-primary w-1/6"
        >Adelie</a
      >
      <a href="/species/Chinstrap" class="menu-item btn btn-primary w-1/6"
        >Chinstrap</a
      >
      <a href="/species/Gentoo" class="menu-item btn btn-primary w-1/6"
        >Gentoo</a
      >
      <a href="/species/All" class="menu-item btn btn-primary w-1/6">All</a>
    </nav>

    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const menuItems = document.querySelectorAll(".menu-item");
  const items = document.querySelectorAll(".item");

  console.log("menuItems", menuItems);
  console.log("items", items);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        const menuItem = document.querySelector(`.menu-item[href="#${id}"]`);
        if (entry.isIntersecting) {
          menuItem?.classList.add("active");
        } else {
          menuItem?.classList.remove("active");
        }
      });
    },
    { threshold: 0.5 },
  );

  items.forEach((item) => {
    observer.observe(item);
  });
</script>
