---
import "../styles/global.css";
---

<!doctype html>
<html lang="en" data-theme="cupcake">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <nav class="flex justify-center bg-base-200 p-5">
      <a href="/" class="btn btn-primary mx-2">accueil</a>
      <select id="species" class="select select-primary" aria-label="Espèce">
        <option value="Adelie">Adelie</option>
        <option value="Chinstrap">Chinstrap</option>
        <option value="Gentoo">Gentoo</option>
        <option value="All">Toutes les espèces</option>
      </select>
    </nav>

    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const items = document.querySelectorAll(".item");

  document.querySelector("#species")?.addEventListener("change", (event) => {
    const value = (event.target as HTMLSelectElement).value;
    location.pathname = "/species/" + value;
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        const menuItem = document.querySelector(`.menu-item[href="#${id}"]`);
        if (entry.isIntersecting) {
          menuItem?.classList.add("active");
        } else {
          menuItem?.classList.remove("active");
        }
      });
    },
    { threshold: 0.5 },
  );

  items.forEach((item) => {
    observer.observe(item);
  });
</script>
