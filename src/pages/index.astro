---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";
---

<Layout>
  <main class="mx-auto max-w-7xl px-5 py-8 md:py-12">
    <section id="overview" class="py-12">
      <div
        class="mb-6 flex flex-col justify-between gap-3 md:flex-row md:items-end"
      >
        <div>
          <h2 class="mt-2 text-3xl font-black">Les données</h2>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="border-l-4 border-primary bg-base-200 p-5">
          <p class="text-sm opacity-70">Individus observés</p>
          <p class="mt-2 text-4xl font-black">{penguins.length}</p>
        </div>
        <div class="border-l-4 border-secondary bg-base-200 p-5">
          <p class="text-sm opacity-70">Espèces étudiées</p>
          <p class="mt-2 text-4xl font-black">3</p>
        </div>
      </div>
    </section>

    <section class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
      <div>
        <h2 class="mt-2 text-3xl font-black">choisir un pinguoin</h2>
        <div class="mt-6 grid gap-3">
          <a
            href="/species/Adelie"
            class="group flex items-center justify-between border border-base-300 p-4 transition-colors hover:border-primary hover:bg-base-200"
          >
            <span><strong>Adelie</strong></span>
            <span class="text-xl transition-transform group-hover:translate-x-1"
              >→</span
            >
          </a>
          <a
            href="/species/Chinstrap"
            class="group flex items-center justify-between border border-base-300 p-4 transition-colors hover:border-secondary hover:bg-base-200"
          >
            <span><strong>Chinstrap</strong></span>
            <span class="text-xl transition-transform group-hover:translate-x-1"
              >→</span
            >
          </a>
          <a
            href="/species/Gentoo"
            class="group flex items-center justify-between border border-base-300 p-4 transition-colors hover:border-accent hover:bg-base-200"
          >
            <span><strong>Gentoo</strong></span>
            <span class="text-xl transition-transform group-hover:translate-x-1"
              >→</span
            >
          </a>
        </div>
      </div>

      <div
        class="overflow-hidden border border-base-300 bg-base-200 p-4 md:p-6"
      >
        <div class="mb-3 flex items-center justify-between">
          <div>
            <p class="text-sm font-bold uppercase tracking-widest opacity-60">
              Vue comparative
            </p>
            <h2 class="text-xl font-bold">Longueur et profondeur du bec</h2>
          </div>
        </div>
        <PlotFigure
          options={{
            marks: [
              Plot.dot(penguins, {
                x: "culmen_length_mm",
                y: "culmen_depth_mm",
                stroke: "species",
              }),
            ],
          }}
        />
      </div>
    </section>
  </main>
</Layout>
