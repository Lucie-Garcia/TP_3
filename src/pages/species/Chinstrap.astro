---
import GraphicSpecies from "../../components/GraphicSpecies.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <main class="mx-auto max-w-6xl px-5 py-10">
        <header
            class="mb-8 flex flex-col gap-5 rounded-3xl bg-secondary p-8 text-secondary-content shadow-xl md:flex-row md:items-end md:justify-between"
        >
            <div>
                <p
                    class="mb-2 text-sm font-bold uppercase tracking-[0.2em] opacity-80"
                >
                    Fiche espèce · 02
                </p>
                <h1 class="text-5xl font-black tracking-tight">Chinstrap</h1>
                <p class="mt-3 max-w-xl text-base opacity-90">
                    Observez les chinstraps !
                </p>
            </div>
            <a href="/species/All" class="btn btn-primary"
                >Voir toutes les espèces</a
            >
        </header>

        <section class="rounded-3xl bg-base-200 p-5 shadow-lg md:p-8">
            <GraphicSpecies species="Chinstrap" />
        </section>
    </main>
</Layout>
