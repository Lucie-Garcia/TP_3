---
import GraphicSpecies from "../../components/GraphicSpecies.astro";
import Layout from "../../layouts/Layout.astro";
---

<Layout>
    <div class="flex flex-col items-center justify-center">
        <h1 class="text-5xl p-3">Navigation</h1>
        <nav aria-label="Navigation des espèces" class="flex flex-row gap-5">
            <a
                href="#adelie"
                class="menu-item btn btn-secondary [.active]:bg-accent"
                >adelie</a
            >
            <a
                href="#chinstrap"
                class="menu-item btn btn-secondary [.active]:bg-accent"
                >chinstrap</a
            >
            <a
                href="#gentoo"
                class="menu-item btn btn-secondary [.active]:bg-accent"
                >gentoo</a
            >
        </nav>
    </div>
    <div class="carousel w-full my-10">
        <div id="adelie" class="item carousel-item relative w-full">
            <div
                class="w-full rounded-2xl bg-base-200 border border-base-300 p-5"
            >
                <GraphicSpecies species="Adelie" />
            </div>
            <div
                class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between"
            >
                <a
                    href="#gentoo"
                    class="btn btn-circle"
                    aria-label="Espèce précédente">❮</a
                >
                <a
                    href="#chinstrap"
                    class="btn btn-circle"
                    aria-label="Espèce suivante">❯</a
                >
            </div>
        </div>
        <div id="chinstrap" class="item carousel-item relative w-full">
            <div class="w-full rounded-2xl bg-base-200 p-5">
                <GraphicSpecies species="Chinstrap" />
            </div>
            <div
                class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between"
            >
                <a
                    href="#adelie"
                    class="btn btn-circle"
                    aria-label="Espèce précédente">❮</a
                >
                <a
                    href="#gentoo"
                    class="btn btn-circle"
                    aria-label="Espèce suivante">❯</a
                >
            </div>
        </div>
        <div id="gentoo" class="item carousel-item relative w-full">
            <div class="w-full rounded-2xl bg-base-200 p-5">
                <GraphicSpecies species="Gentoo" />
            </div>
            <div
                class="absolute left-5 right-5 top-1/2 flex -translate-y-1/2 transform justify-between"
            >
                <a
                    href="#chinstrap"
                    class="btn btn-circle"
                    aria-label="Espèce précédente">❮</a
                >
                <a
                    href="#adelie"
                    class="btn btn-circle"
                    aria-label="Espèce suivante">❯</a
                >
            </div>
        </div>
    </div>
</Layout>
